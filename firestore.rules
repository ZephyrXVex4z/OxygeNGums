rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    // Admin: crea manualmente en la consola el documento admins/{UID} (cualquier campo). Nadie puede crearlo desde la web.
    match /admins/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /reviews/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','rating','text','at'])
          && request.resource.data.uid == uid
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
      }
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','createdAt']);
    }
  }
}
